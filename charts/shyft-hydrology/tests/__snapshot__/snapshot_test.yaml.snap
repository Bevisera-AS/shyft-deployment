        - name: rmd
          port: 20002
          protocol: TCP
          targetPort: rmd
        - name: parameter
          port: 20004
          protocol: TCP
          targetPort: parameter
        - name: state
          port: 20006
          protocol: TCP
          targetPort: state
        - name: dtss
          port: 20010
          protocol: TCP
          targetPort: dtss
        - name: dstm
          port: 20012
