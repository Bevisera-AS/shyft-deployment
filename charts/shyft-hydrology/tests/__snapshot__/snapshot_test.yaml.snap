  2: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: drms
        app.kubernetes.io/instance: shyft-hydrology
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: shyft-hydrology
        app.kubernetes.io/part-of: shyft
        app.kubernetes.io/version: snapshot
        helm.sh/chart: shyft-hydrology-0.0.0
      name: shyft-hydrology-drms
    spec:
      replicas: 8
      selector:
        matchLabels:
          app.kubernetes.io/component: drms
          app.kubernetes.io/instance: shyft-hydrology
          app.kubernetes.io/name: shyft-hydrology
      template:
        metadata:
          annotations:
            example.org/owner: hydrology
          labels:
            app.kubernetes.io/component: drms
            app.kubernetes.io/instance: shyft-hydrology
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: shyft-hydrology
            app.kubernetes.io/part-of: shyft
            app.kubernetes.io/version: snapshot
            helm.sh/chart: shyft-hydrology-0.0.0
            team: hydrology
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - --interface
                - $(POD_IP)
                - --host
                - shyft-hydrology
                - --root-dir
                - /tmp
              command:
                - python3
                - /opt/shyft/hydrology/service/drms.py
              env:
                - name: PYTHONUNBUFFERED
                  value: "1"
                - name: SHYFT_SERVICE_BASE_PORT
                  value: "22000"
                - name: POD_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.podIP
                - name: TZ
                  value: UTC
              image: registry.example.org/shyft/fedora44-shyft-app:snapshot@sha256:5cf8df47518e66664ba7b7f309d973fd5e0fc9e052829d38fa3a0d0bceec752f
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 6
                periodSeconds: 10
                tcpSocket:
                  port: drms
              name: drms
              ports:
                - containerPort: 22008
                  name: drms
                  protocol: TCP
              readinessProbe:
                failureThreshold: 3
                periodSeconds: 5
                tcpSocket:
                  port: drms
              resources:
                limits:
                  cpu: "16"
                  memory: 64Gi
                requests:
                  cpu: "16"
                  memory: 64Gi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              startupProbe:
                failureThreshold: 60
                periodSeconds: 2
                tcpSocket:
                  port: drms
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /shyft-data
                  name: data
                  readOnly: true
          enableServiceLinks: false
          imagePullSecrets:
            - name: regcred
          nodeSelector:
            pool: drms
          priorityClassName: low
          securityContext:
            fsGroup: 1000
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 1000
            runAsNonRoot: true
            runAsUser: 1000
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: shyft-hydrology
          terminationGracePeriodSeconds: 30
          tolerations:
            - key: dedicated
              operator: Exists
          topologySpreadConstraints:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/component: drms
                  app.kubernetes.io/instance: shyft-hydrology
                  app.kubernetes.io/name: shyft-hydrology
              maxSkew: 1
              topologyKey: kubernetes.io/hostname
              whenUnsatisfiable: ScheduleAnyway
            - maxSkew: 2
              topologyKey: topology.kubernetes.io/zone
              whenUnsatisfiable: ScheduleAnyway
          volumes:
            - emptyDir: {}
              name: tmp
            - name: data
              persistentVolumeClaim:
                claimName: shyft-data
                readOnly: true
