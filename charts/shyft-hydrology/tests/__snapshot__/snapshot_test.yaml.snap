  2: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: drms
        app.kubernetes.io/instance: shyft-hydrology
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: shyft-hydrology
        app.kubernetes.io/part-of: shyft
        app.kubernetes.io/version: snapshot
        helm.sh/chart: shyft-hydrology-0.0.0
      name: shyft-hydrology-drms
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: drms
          app.kubernetes.io/instance: shyft-hydrology
          app.kubernetes.io/name: shyft-hydrology
      template:
        metadata:
          labels:
            app.kubernetes.io/component: drms
            app.kubernetes.io/instance: shyft-hydrology
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: shyft-hydrology
            app.kubernetes.io/part-of: shyft
            app.kubernetes.io/version: snapshot
            helm.sh/chart: shyft-hydrology-0.0.0
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - --interface
                - $(POD_IP)
                - --host
                - shyft-hydrology
                - --root-dir
                - /tmp
              command:
                - python3
                - /opt/shyft/hydrology/service/drms.py
              env:
                - name: PYTHONUNBUFFERED
                  value: "1"
                - name: SHYFT_SERVICE_BASE_PORT
                  value: "20000"
                - name: POD_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.podIP
              image: registry.gitlab.com/shyft-os/shyft/fedora44-shyft-app:snapshot
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 6
                periodSeconds: 10
                tcpSocket:
                  port: drms
              name: drms
              ports:
                - containerPort: 20008
                  name: drms
                  protocol: TCP
              readinessProbe:
                failureThreshold: 3
                periodSeconds: 5
                tcpSocket:
                  port: drms
              resources:
                limits:
                  memory: 2Gi
                requests:
                  cpu: 250m
                  memory: 512Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              startupProbe:
                failureThreshold: 60
                periodSeconds: 2
                tcpSocket:
                  port: drms
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
          enableServiceLinks: false
          securityContext:
            fsGroup: 1000
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 1000
            runAsNonRoot: true
            runAsUser: 1000
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: shyft-hydrology
          terminationGracePeriodSeconds: 30
          topologySpreadConstraints:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/component: drms
                  app.kubernetes.io/instance: shyft-hydrology
                  app.kubernetes.io/name: shyft-hydrology
              maxSkew: 1
              topologyKey: kubernetes.io/hostname
              whenUnsatisfiable: ScheduleAnyway
          volumes:
            - emptyDir: {}
              name: tmp
  3: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      labels:
        app.kubernetes.io/component: core
        app.kubernetes.io/instance: shyft-hydrology
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: shyft-hydrology
        app.kubernetes.io/part-of: shyft
        app.kubernetes.io/version: snapshot
        helm.sh/chart: shyft-hydrology-0.0.0
      name: shyft-hydrology-core
    spec:
      ingress:
        - from:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/component: drms
                  app.kubernetes.io/instance: shyft-hydrology
                  app.kubernetes.io/name: shyft-hydrology
            - podSelector:
                matchLabels:
                  app.kubernetes.io/component: test
                  app.kubernetes.io/instance: shyft-hydrology
                  app.kubernetes.io/name: shyft-hydrology
            - podSelector: {}
          ports:
            - port: 20000
              protocol: TCP
            - port: 20002
              protocol: TCP
            - port: 20004
              protocol: TCP
            - port: 20006
              protocol: TCP
            - port: 20010
              protocol: TCP
            - port: 20012
              protocol: TCP
            - port: 20014
              protocol: TCP
            - port: 20016
              protocol: TCP
      podSelector:
        matchLabels:
          app.kubernetes.io/component: core
          app.kubernetes.io/instance: shyft-hydrology
          app.kubernetes.io/name: shyft-hydrology
      policyTypes:
        - Ingress
