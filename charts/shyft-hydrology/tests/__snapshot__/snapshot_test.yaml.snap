  1: |
    apiVersion: apps/v1
    kind: StatefulSet
    metadata:
      labels:
        app.kubernetes.io/component: core
        app.kubernetes.io/instance: shyft-hydrology
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: shyft-hydrology
        app.kubernetes.io/part-of: shyft
        app.kubernetes.io/version: snapshot
        helm.sh/chart: shyft-hydrology-0.0.0
      name: shyft-hydrology-core
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: core
          app.kubernetes.io/instance: shyft-hydrology
          app.kubernetes.io/name: shyft-hydrology
      serviceName: shyft-hydrology
      template:
        metadata:
          annotations:
            example.org/owner: hydrology
          labels:
            app.kubernetes.io/component: core
            app.kubernetes.io/instance: shyft-hydrology
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: shyft-hydrology
            app.kubernetes.io/part-of: shyft
            app.kubernetes.io/version: snapshot
            helm.sh/chart: shyft-hydrology-0.0.0
            team: hydrology
        spec:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: pool
                        operator: In
                        values:
                          - core
          automountServiceAccountToken: false
          containers:
            - command:
                - python3
                - /opt/shyft/hydrology/service/task.py
              env:
                - name: PYTHONUNBUFFERED
                  value: "1"
                - name: SHYFT_SERVICE_BASE_PORT
                  value: "22000"
                - name: SHYFT_SERVICE_ROOT
                  value: /shyft-var
                - name: SHYFT_SERVICE_INTERFACE
                  value: 0.0.0.0
                - name: TZ
                  value: UTC
              image: registry.example.org/shyft/fedora44-shyft-app:snapshot@sha256:5cf8df47518e66664ba7b7f309d973fd5e0fc9e052829d38fa3a0d0bceec752f
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 6
                periodSeconds: 10
                tcpSocket:
                  port: task
              name: task
              ports:
                - containerPort: 22000
                  name: task
                  protocol: TCP
