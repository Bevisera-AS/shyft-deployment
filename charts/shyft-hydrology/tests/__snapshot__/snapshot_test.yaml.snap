renders the defaults:
  1: |
    apiVersion: apps/v1
    kind: StatefulSet
    metadata:
      labels:
        app.kubernetes.io/component: core
        app.kubernetes.io/instance: shyft-hydrology
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: shyft-hydrology
        app.kubernetes.io/part-of: shyft
        app.kubernetes.io/version: snapshot
        helm.sh/chart: shyft-hydrology-0.0.0
      name: shyft-hydrology-core
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: core
          app.kubernetes.io/instance: shyft-hydrology
          app.kubernetes.io/name: shyft-hydrology
      serviceName: shyft-hydrology
      template:
        metadata:
          labels:
            app.kubernetes.io/component: core
            app.kubernetes.io/instance: shyft-hydrology
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: shyft-hydrology
            app.kubernetes.io/part-of: shyft
            app.kubernetes.io/version: snapshot
            helm.sh/chart: shyft-hydrology-0.0.0
        spec:
          automountServiceAccountToken: false
          containers:
            - command:
                - python3
                - /opt/shyft/hydrology/service/task.py
              env:
                - name: PYTHONUNBUFFERED
                  value: "1"
                - name: SHYFT_SERVICE_BASE_PORT
                  value: "20000"
                - name: SHYFT_SERVICE_ROOT
                  value: /shyft-var
                - name: SHYFT_SERVICE_INTERFACE
                  value: 0.0.0.0
              image: registry.gitlab.com/shyft-os/shyft/fedora44-shyft-app:snapshot
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 6
                periodSeconds: 10
                tcpSocket:
                  port: task
              name: task
              ports:
                - containerPort: 20000
                  name: task
                  protocol: TCP
              readinessProbe:
                failureThreshold: 3
                periodSeconds: 5
                tcpSocket:
                  port: task
              resources:
                limits:
                  memory: 1Gi
                requests:
                  cpu: 100m
                  memory: 256Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              startupProbe:
                failureThreshold: 60
                periodSeconds: 2
                tcpSocket:
                  port: task
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /shyft-var
                  name: var
            - command:
                - python3
                - /opt/shyft/hydrology/service/rmd.py
              env:
                - name: PYTHONUNBUFFERED
                  value: "1"
                - name: SHYFT_SERVICE_BASE_PORT
                  value: "20000"
                - name: SHYFT_SERVICE_ROOT
                  value: /shyft-var
                - name: SHYFT_SERVICE_INTERFACE
                  value: 0.0.0.0
              image: registry.gitlab.com/shyft-os/shyft/fedora44-shyft-app:snapshot
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 6
                periodSeconds: 10
                tcpSocket:
                  port: rmd
              name: rmd
              ports:
                - containerPort: 20002
                  name: rmd
                  protocol: TCP
              readinessProbe:
                failureThreshold: 3
                periodSeconds: 5
                tcpSocket:
                  port: rmd
              resources:
                limits:
                  memory: 1Gi
                requests:
                  cpu: 50m
                  memory: 256Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              startupProbe:
                failureThreshold: 60
                periodSeconds: 2
                tcpSocket:
                  port: rmd
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /shyft-var
                  name: var
            - command:
                - python3
                - /opt/shyft/hydrology/service/parameter.py
              env:
                - name: PYTHONUNBUFFERED
                  value: "1"
                - name: SHYFT_SERVICE_BASE_PORT
                  value: "20000"
                - name: SHYFT_SERVICE_ROOT
